// Prisma Schema — Social Media Scheduler
// Conforms strictly to docs/Sprint/Sakhaa Forge Social Scheduler — Sprint 1 Documentation.md
// and docs/05_data_models.md

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------
// Sprint 1 Core Social Scheduler Models (Section 18)
// ---------------------------------------------------------

enum SocialSchedulerPostStatus {
  DRAFT
  SCHEDULED
  MOCK_READY
  CANCELLED
  FAILED
}

enum SocialSchedulerMediaStatus {
  INITIATED
  UPLOADING
  UPLOADED
  FAILED
}

enum SocialSchedulerPlatform {
  FACEBOOK
  INSTAGRAM
  PINTEREST
  YOUTUBE
  X
}

enum SocialSchedulerTargetStatus {
  SELECTED
  MOCK_READY
  BLOCKED
  CANCELLED
}

model ScheduledSocialPost {
  id               String                    @id @default(uuid())
  workspaceId      String                    @map("workspace_id")
  createdByUserId  String                    @map("created_by_user_id")

  title            String
  status           SocialSchedulerPostStatus @default(DRAFT)

  draftContentJson Json                      @map("draft_content_json")
  scheduledAt      DateTime?                 @map("scheduled_at")
  timezone         String?

  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  cancelledAt      DateTime?                 @map("cancelled_at")

  media            SocialPostMedia[]
  targets          SocialPublishTarget[]

  @@index([workspaceId, status])
  @@index([workspaceId, scheduledAt])
  @@map("scheduled_social_posts")
}

model SocialMediaAsset {
  id               String                     @id @default(uuid())
  workspaceId      String                     @map("workspace_id")
  uploadedByUserId String                     @map("uploaded_by_user_id")

  originalFileName String                     @map("original_file_name")
  safeFileName     String                     @map("safe_file_name")
  mimeType         String                     @map("mime_type")
  byteSize         BigInt                     @map("byte_size")
  bucket           String
  objectKey        String                     @map("object_key")

  sha256           String?
  width            Int?
  height           Int?
  durationMs       Int?                       @map("duration_ms")

  status           SocialSchedulerMediaStatus @default(INITIATED)
  metadataJson     Json?                      @map("metadata_json")

  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")

  posts            SocialPostMedia[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("social_media_assets")
}

model SocialPostMedia {
  id           String              @id @default(uuid())
  postId       String              @map("post_id")
  mediaAssetId String              @map("media_asset_id")
  order        Int                 @default(0)
  role         String              @default("primary")

  post         ScheduledSocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAsset   SocialMediaAsset    @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([postId, mediaAssetId])
  @@index([postId])
  @@map("social_post_media")
}

model SocialPublishTarget {
  id                String                      @id @default(uuid())
  postId            String                      @map("post_id")
  workspaceId       String                      @map("workspace_id")

  platform          SocialSchedulerPlatform
  mockAccountName   String?                     @map("mock_account_name")
  externalAccountId String?                     @map("external_account_id")

  status            SocialSchedulerTargetStatus @default(SELECTED)
  validationJson    Json?                       @map("validation_json")

  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")

  post              ScheduledSocialPost         @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([workspaceId, platform])
  @@index([postId])
  @@map("social_publish_targets")
}

// ---------------------------------------------------------
// General Core Models
// ---------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model SocialAccount {
  id                    String    @id @default(cuid())
  ownerId               String?   @map("owner_id")
  workspaceId           String?   @map("workspace_id")
  platform              String
  displayName           String?   @map("display_name")
  platformAccountId     String    @map("platform_account_id")
  accessTokenEncrypted  String    @map("access_token_encrypted")
  refreshTokenEncrypted String?   @map("refresh_token_encrypted")
  expiresAt             DateTime? @map("expires_at")
  scopesJson            String?   @map("scopes_json")
  status                String    @default("CONNECTED")
  metadataJson          String?   @map("metadata_json")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("social_accounts")
}
